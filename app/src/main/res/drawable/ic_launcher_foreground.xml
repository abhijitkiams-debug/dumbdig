<?xml version="1.0" encoding="utf-8"?>
<!-- Original adaptive-icon foreground: a drawn longbow with a nocked arrow,
     for Ram the divine archer. Pure vector paths (no imported art). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bow arc (golden longbow) -->
    <path
        android:strokeColor="#FFD24A"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M40,26 C66,40 66,68 40,82" />

    <!-- Bowstring -->
    <path
        android:strokeColor="#FFE9A8"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:pathData="M40,26 L40,82" />

    <!-- Arrow shaft -->
    <path
        android:strokeColor="#FF8A1E"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M34,54 L84,54" />

    <!-- Arrowhead -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M84,54 L74,49 L74,59 Z" />

    <!-- Fletching -->
    <path
        android:fillColor="#FF4D5E"
        android:pathData="M34,54 L28,49 L30,54 L28,59 Z" />
</vector>
