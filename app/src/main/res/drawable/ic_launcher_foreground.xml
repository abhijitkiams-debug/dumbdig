<?xml version="1.0" encoding="utf-8"?>
<!-- Original adaptive-icon foreground: two interlocking chevrons representing
     the "flip" mechanic. Drawn entirely as vector paths (no imported art). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Upper chevron (gravity = up) -->
    <path
        android:fillColor="#22E0C8"
        android:pathData="M30,46 L54,30 L78,46 L78,58 L54,42 L30,58 Z" />

    <!-- Lower chevron (gravity = down) -->
    <path
        android:fillColor="#FF4D7A"
        android:pathData="M30,62 L54,78 L78,62 L78,50 L54,66 L30,50 Z" />
</vector>
